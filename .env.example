# =============================================================================
# Platform selection
# =============================================================================
# Which prediction market platform to use: "manifold" or "polymarket"
TRADING_PLATFORM=manifold

# =============================================================================
# Manifold Markets (play-money, no real capital — recommended for testing)
# Get your API key at: https://manifold.markets/profile
# =============================================================================
MANIFOLD_API_KEY=your_manifold_api_key_here

# =============================================================================
# Polymarket (real money, blocked in Germany/EU — production only)
# =============================================================================
POLYMARKET_PK=your_ethereum_private_key_here
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_API_SECRET=your_polymarket_api_secret_here
POLYMARKET_PASSPHRASE=your_polymarket_passphrase_here

# =============================================================================
# Redis (required for simulation/live mode switching)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2

# =============================================================================
# Trading parameters (override defaults from code)
# =============================================================================
MAX_POSITION_SIZE=1.0
STOP_LOSS_PCT=0.15
TAKE_PROFIT_PCT=0.25
